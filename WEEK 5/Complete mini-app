<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Counter Mini-App</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f0f4f8;
            padding: 60px 15px;
        }
        .container {
            background: white;
            max-width: 350px;
            margin: auto;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 12px #cccccc;
        }
        h1 {
            color: #2563eb;
        }
        #count {
            font-size: 50px;
            color: #2563eb;
            margin: 20px;
        }
        button {
            padding: 12px 18px;
            margin: 5px;
            border: none;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }
        button:hover {
            opacity: 0.8;
        }
        .reset {
            background: #dc2626;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Counter App</h1>
        <p>Click the buttons to change the number.</p>
        <div id="count">0</div>
        <button onclick="change(1)">+ Add</button>
        <button onclick="change(-1)">- Subtract</button>
        <button class="reset" onclick="reset()">Reset</button>
    </div>
    <script>
        let count = 0;
        function change(amount) {
            count = count + amount;
            document.getElementById("count").textContent = count;
        }
        function reset() {
            count = 0;
            document.getElementById("count").textContent = count;
        }
    </script>
</body>
</html>
