<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Styled Heading and Paragraph</title>

  <style>
    h1 {
      color: #15803d;
      text-align: center;
      font-size: 2.5rem;
    }

    p {
      color: #64748b;
      font-size: 1.1rem;
    }
  </style>
</head>

<body>

  <h1>My Heading</h1>
  <p>This is my paragraph with muted grey text.</p>

</body>
</html>
