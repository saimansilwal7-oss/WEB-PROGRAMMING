<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sale Card</title>

    <style>
        .card {
            width: 280px;
            height: 180px;
            background: white;
            border: 2px solid teal;
            border-radius: 12px;
            position: relative;
            padding: 20px;
            box-sizing: border-box;
        }

        .badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: teal;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="card">
        <span class="badge">SALE</span>
        <h2>Special Offer</h2>
        <p>Get this product at a great price!</p>
    </div>

</body>
</html>
